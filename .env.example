# Copiez ce fichier en « .env » pour le développement local (il est ignoré par git).
# En production, définissez ces variables dans le tableau de bord de l'hébergeur.

# "production" active les cookies sécurisés (HTTPS obligatoire)
ENV=development

# Clé secrète pour signer les sessions. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base de données. Laisser vide en local (SQLite). En production : URL Postgres.
# DATABASE_URL=postgresql://user:motdepasse@hote:5432/base

# Compte administrateur créé au premier démarrage (s'il n'existe pas déjà)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CHURCH_NAME=EJP ST Etienne

# Autoriser d'autres églises à créer un compte (true/false)
ALLOW_REGISTRATION=true

# Envoi des e-mails « mot de passe oublié » (Gmail : mot de passe d'application)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# URL publique (pour les liens dans les e-mails), ex. https://planning-ejp.onrender.com
PUBLIC_URL=
